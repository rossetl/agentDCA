{
  "mcpServers": {
    "agentdca": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--project",
        "${PLUGIN_ROOT}/pyproject.toml",
        "agentdca-mcp"
      ],
      "env": {
        "MPLCONFIGDIR": "/tmp/agentdca-matplotlib",
        "UV_CACHE_DIR": "/tmp/agentdca-uv-cache"
      },
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 3600
    }
  }
}
